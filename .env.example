# Copy to this directory's ignored .env.local, then supply your own provider key.
# Process environment variables take precedence. Never commit .env.local.
# No original deployment, database, access code or administrator token is needed.

# DeepSeek-compatible text interface. Use your own provider credentials.
TEXT_AGENT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions

# Alternative existing OpenAI route; select this instead of DeepSeek above.
# TEXT_AGENT_PROVIDER=openai
# OPENAI_API_KEY=
# TEXT_AGENT_MODEL=gpt-6.1-sol
# TEXT_AGENT_REASONING_EFFORT=medium
# TEXT_AGENT_ROUTING_PROFILE=sol-luna-v1

# Optional verbatim voice; text remains available without these credentials.
# NPC_VOICE_PROVIDER=qwen
# QWEN_VOICE_MODE=flash
# DASHSCOPE_API_KEY=
# SFM_WORKSPACE_ID=

# Optional expression detection / explicitly requested recap images.
# GOOGLE_VISION_API_KEY=
# OPENAI_API_KEY=

# Start locally: python run_game.py
# Opt into local accounts, saved progress and both-language questionnaires:
#   python run_game.py --paired
# The launcher creates a fresh .local-data directory and random local secret.
# Keep that private directory to restore your own local progress after restart.
# It never connects to an AWS research database. Do not publish local data.
